{
  "mcpServers": {
    "railway": {
      "command": "uvx",
      "args": [
        "railway-mcp-server"
      ],
      "env": {
        "RAILWAY_API_TOKEN": "${RAILWAY_API_TOKEN}",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "create_project",
        "list_projects",
        "get_project_details",
        "deploy_project"
      ]
    }
  }
}
